DATABASE_URL="postgresql://foodie:foodie@localhost:5432/foodie?schema=public"
JWT_SECRET="CHANGE_ME_to_a_long_random_string_at_least_32_chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"
# 高德「Web端(JS API)」Key —— 控制台创建应用时类型选「Web端(JS API)」
NEXT_PUBLIC_AMAP_JS_KEY=""
# 该 JS Key 配套的安全密钥（securityJsCode），控制台 Key 详情页可查看，必填
NEXT_PUBLIC_AMAP_SECURITY_CODE=""
# 高德「Web服务」Key —— 另一类应用，服务端 REST API 用（geocode/place 等），可选
AMAP_WEB_KEY=""
DEFAULT_CITY="成都"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"

# ── FoodMap Agent 接入（可选；不配则 /api/agent/* 返回 503，其余功能不受影响）──
# Agent 跑在内网工作站，由本机 frpc 把 127.0.0.1:7801 发布到 frps 的 3001。
# 平台与 frps 同机时填 http://127.0.0.1:3001（本地回环，不必绕公网）；
# 不同机才填公网地址。不带尾斜杠。
AGENT_A2A_BASE_URL="http://127.0.0.1:3001"
# 与 Agent 侧 FOODIE_A2A_TOKEN 一致的静态 Bearer
AGENT_A2A_TOKEN=""
# 任务级 token 有效期：一轮 取媒体→转写→校验→建图 可能 10 分钟，15m 不够
JWT_TASK_TTL="45m"
# 单任务流式上限（毫秒），默认 12 分钟
AGENT_STREAM_TIMEOUT_MS="720000"
# 构建并发，默认 1（1.6G 的云服务器上 cpus:2 会 OOM）；本机可设 4
NEXT_BUILD_CPUS="1"
