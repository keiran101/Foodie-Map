generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Visibility {
  PUBLIC
  UNLISTED
  PRIVATE
}

enum NavProvider {
  AMAP
  BAIDU
  TENCENT
}

enum ParseStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

/// 一次「用链接/清单自动建合集」的生命周期。
///
/// 为什么这要落库：Agent 那一轮要跑 3–10 分钟，而它的执行者根本不在这个进程里
/// （Agent 在内网工作站）。之前任务状态只活在浏览器的那条 SSE 连接上，连接一断
/// —— 切后台被系统丢弃、刷新、跳到别的路由、Clash/NAT 掐长连接 —— 状态就永久消失，
/// 用户看到的是 network error，实际上 Agent 那边还在跑、合集早就建好了。
/// 任务一旦是库里的实体，断连就只是「少看几帧进度」，不再是「这次白做了」。
enum BuildStatus {
  RUNNING
  COMPLETED
  FAILED
  /// 用户主动中断：不再追踪，但 Agent 侧的子进程不保证随之回收
  CANCELED
  /// 进程重启等导致失去跟踪，且没有找回产物
  STALE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  nickname     String
  avatar       String?
  bio          String?
  isCreator    Boolean  @default(false)
  createdAt    DateTime @default(now())

  maps        FoodMap[]
  collections Collection[]
  follows     Follow[]     @relation("Following")
  followers   Follow[]     @relation("Follower")
  navLogs     NavLog[]
  mapLikes    MapLike[]
  mapDislikes MapDislike[]
  favorites   Favorite[]
  comments    Comment[]
  mapForks    MapFork[]
  buildTasks  BuildTask[]
}

model FoodMap {
  id          String     @id @default(cuid())
  ownerId     String
  owner       User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title       String
  description String?
  coverUrl    String?
  city        String?
  visibility  Visibility @default(PUBLIC)
  viewCount   Int        @default(0)
  createdAt   DateTime   @default(now())

  places    Place[]
  likes     MapLike[]
  dislikes  MapDislike[]
  favorites Favorite[]
  comments  Comment[]
  forks     MapFork[]

  @@index([visibility, createdAt])
}

model Place {
  id            String       @id @default(cuid())
  name          String
  address       String?
  lng           Decimal
  lat           Decimal
  amapPoiId     String?
  category      String?
  phone         String?
  avgPrice      Int?
  note          String?
  rating        Float?
  mapId         String
  map           FoodMap      @relation(fields: [mapId], references: [id], onDelete: Cascade)
  collectionId  String?
  collection    Collection?  @relation(fields: [collectionId], references: [id], onDelete: SetNull)
  sourceVideoId String?
  sourceVideo   SourceVideo? @relation(fields: [sourceVideoId], references: [id], onDelete: SetNull)
  orderIndex    Int          @default(0)
  createdAt     DateTime     @default(now())

  navLogs NavLog[]

  @@index([mapId, orderIndex])
  @@index([lng, lat])
}

model Collection {
  id         String     @id @default(cuid())
  ownerId    String
  owner      User       @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title      String
  city       String?
  coverUrl   String?
  visibility Visibility @default(PUBLIC)
  placeCount Int        @default(0)
  createdAt  DateTime   @default(now())

  places Place[]
}

model Follow {
  followerId  String
  followingId String
  createdAt   DateTime @default(now())

  follower  User @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following User @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
}

model MapLike {
  userId    String
  mapId     String
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  FoodMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([userId, mapId])
}

model MapDislike {
  userId    String
  mapId     String
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  FoodMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([userId, mapId])
}

model Favorite {
  userId    String
  mapId     String
  createdAt DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  FoodMap @relation(fields: [mapId], references: [id], onDelete: Cascade)

  @@id([userId, mapId])
}

model Comment {
  id        String   @id @default(cuid())
  mapId     String
  userId    String
  content   String   @db.VarChar(500)
  createdAt DateTime @default(now())

  map  FoodMap @relation(fields: [mapId], references: [id], onDelete: Cascade)
  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([mapId, createdAt])
}

model MapFork {
  id          String   @id @default(cuid())
  userId      String
  sourceMapId String
  newMapId    String
  createdAt   DateTime @default(now())

  user User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  map  FoodMap @relation(fields: [sourceMapId], references: [id], onDelete: Cascade)
}

model NavLog {
  id        String      @id @default(cuid())
  userId    String?
  placeId   String
  provider  NavProvider
  createdAt DateTime    @default(now())

  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)
  place Place @relation(fields: [placeId], references: [id], onDelete: Cascade)
}

model SourceVideo {
  id          String      @id @default(cuid())
  platform    String?
  url         String
  authorName  String?
  title       String?
  transcript  String?
  parseStatus ParseStatus @default(PENDING)
  rawJson     String?
  mapId       String?
  createdAt   DateTime    @default(now())

  places Place[]
}

/// 一次自动建合集任务。状态的唯一真相在这里，不在浏览器的那条 HTTP 连接上。
model BuildTask {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// 用户原始输入：视频链接、店铺清单，或一句自然语言
  source     String
  /// 调用方指定的城市；为空则由 Agent 从内容推断（推断结果见 result.citySource）
  city       String?
  /// 调用方指定的标题；为空则由 Agent 起
  title      String?
  visibility Visibility  @default(UNLISTED)
  status     BuildStatus @default(RUNNING)
  /// 最新一条进度文案，列表/恢复时先显示这个
  progress   String?
  /// 进度时间线 [{t, message}]，t 是相对任务开始的秒数。上限由执行器截断
  steps      Json?
  /// Agent 回报的产出原样：{mapId,city,citySource,added,missing,visibility,recovered?}
  result     Json?
  /// 从 result 提出来单独成列，方便直接跳转与统计
  mapId      String?
  /// Agent 的原话（含它认为的失败原因），只报失败时这里是唯一线索
  message    String?
  error      String?
  createdAt  DateTime    @default(now())
  /// 执行器每 flush 一次进度就更新它。回收 STALE 靠这个字段判断「多久没动静」
  updatedAt  DateTime    @updatedAt
  finishedAt DateTime?

  @@index([userId, createdAt])
  @@index([status, updatedAt])
}
